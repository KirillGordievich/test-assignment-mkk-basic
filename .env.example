# App
API_KEY=dev-api-key
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments

# Payment gateway emulation (failure_rate=1 makes every payment fail: handy for retry/DLQ checks)
GATEWAY_FAILURE_RATE=0.1
GATEWAY_MIN_DELAY_S=2
GATEWAY_MAX_DELAY_S=5

# Payment consumer: webhook retries with exponential backoff
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BASE_DELAY_MS=5000
CONSUMER_WEBHOOK_TIMEOUT_S=5

# Outbox relay
OUTBOX_POLL_INTERVAL_S=1
OUTBOX_BATCH_SIZE=50

# Expiry of payments stuck in pending (TTL must exceed the time a payment can spend in the queues)
EXPIRY_INTERVAL_S=300
EXPIRY_TTL_S=1800
EXPIRY_BATCH_SIZE=100
